rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isGuru() {
      return hasRole('guru');
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isGuruOrAdmin() {
      return isGuru() || isAdmin();
    }

    // ------------------------------------------------------------------------
    // User Profiles Collection: users/{userId}
    // ------------------------------------------------------------------------
    match /users/{userId} {
      // Siswa can read their own profile; Guru/Admin can read all user profiles
      allow read: if isSignedIn() && (isOwner(userId) || isGuruOrAdmin());
      
      // Admin can create/update/delete any profile.
      // User can create/update their own profile during signup/profile edit.
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();

      // ----------------------------------------------------------------------
      // Attendance Subcollection: users/{userId}/attendance/{date}
      // ----------------------------------------------------------------------
      match /attendance/{dateId} {
        // Siswa can read their own attendance history; Guru & Admin can read all
        allow read: if isSignedIn() && (isOwner(userId) || isGuruOrAdmin());
        
        // Siswa can submit/update attendance for themselves; Guru & Admin can update status
        allow create: if isSignedIn() && (isOwner(userId) || isGuruOrAdmin());
        allow update: if isSignedIn() && (isOwner(userId) || isGuruOrAdmin());
        
        // Only Admin can delete attendance records
        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------------------------------
    // School Details & Config: details/school
    // ------------------------------------------------------------------------
    match /details/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // Class Rooms: classRooms/{classId}
    // ------------------------------------------------------------------------
    match /classRooms/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // Teacher Assignments: teacherAssignments/{assignmentId}
    // ------------------------------------------------------------------------
    match /teacherAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
